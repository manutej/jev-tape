# Copy this file to .env and fill the first line.
#   cp .env.example .env
# Never commit .env. Never paste the key into a chat.

TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Writes stay off unless you flip these on a machine you own.
JEV_TAPE_ALLOW_SEND=0
JEV_TAPE_ALLOW_PUSH=0
